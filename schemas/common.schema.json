{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/outcome/common.schema.json",
  "$defs": {
    "contract_id": {"type": "string", "pattern": "^oc_[0-9a-f]{32}$"},
    "observation_id": {"type": "string", "pattern": "^oo_[0-9a-f]{32}$"},
    "criterion_id": {"type": "string", "pattern": "^c_[a-z0-9_-]{1,48}$"},
    "board": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "format": "date-time"},
    "pointer": {"type": "string", "maxLength": 512, "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9/_.~-]*)?$"},
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "requires_baseline"],
      "properties": {
        "id": {"$ref": "#/$defs/criterion_id"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S"},
        "requires_baseline": {"type": "boolean"}
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["before", "after", "comparison", "pointer"],
      "properties": {
        "before": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
        "after": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
        "comparison": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
        "pointer": {"anyOf": [{"$ref": "#/$defs/pointer"}, {"type": "null"}]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "kind", "finding", "summary", "pointer", "baseline"],
      "properties": {
        "criterion_id": {"$ref": "#/$defs/criterion_id"},
        "kind": {"const": "outcome"},
        "finding": {"enum": ["supported", "contradicted", "unknown"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S"},
        "pointer": {"anyOf": [{"$ref": "#/$defs/pointer"}, {"type": "null"}]},
        "baseline": {"anyOf": [{"$ref": "#/$defs/baseline"}, {"type": "null"}]}
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["observe_when", "deadline", "anchor", "delay_seconds"],
      "properties": {
        "observe_when": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
        "deadline": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "anchor": {"enum": [null, "done", "integration", "deployment", "first_workflow"]},
        "delay_seconds": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 31536000}, {"type": "null"}]}
      },
      "allOf": [{
        "if": {"properties": {"anchor": {"type": "null"}}},
        "then": {"properties": {"delay_seconds": {"type": "null"}}},
        "else": {"properties": {"delay_seconds": {"type": "integer"}}}
      }]
    }
  }
}
